<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.7" />
    <Reference Include="SPORTident.Communication">
      <HintPath>$(SPORTIDENT_SDK_DLL)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequirePrivateSportIdentSdk" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(SPORTIDENT_SDK_DLL)' == '' Or !Exists('$(SPORTIDENT_SDK_DLL)')"
           Text="Set SPORTIDENT_SDK_DLL to a private SPORTident.Communication.dll outside the repository." />
  </Target>
</Project>
