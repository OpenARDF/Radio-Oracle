<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.readouts.ReadoutFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/results_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/event_toolbar_background"
        android:minHeight="?attr/actionBarSize"
        android:theme="@style/Theme.RadioOracle"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/results_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="72dp"
        app:layoutManager="LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/results_preliminary_notice"
        tools:layout_editor_absoluteX="28dp" />

    <TextView
        android:id="@+id/results_preliminary_notice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFF4D6"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textColor="#4B3600"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/results_toolbar"
        tools:text="Preliminary Results - Pending Organizer Review"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
