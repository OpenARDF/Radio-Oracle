<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/sportident_card_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/event_toolbar_background"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/sportident_card_presence_dot"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/sportident_card_presence_dot"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/sportident_card_presence_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/sportident_card_not_detected"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/sportident_card_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/sportident_card_insert_now"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/red_error"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sportident_card_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/sportident_card_ready"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textSize="18sp" />

            <ProgressBar
                android:id="@+id/sportident_card_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/sportident_card_name_to_write"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Card-holder names are hardware data and are intentionally not offered to autofill. -->
            <EditText
                android:id="@+id/sportident_card_first_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/sportident_card_first_name"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/sportident_card_last_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/sportident_card_last_name"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:textSize="18sp" />

            <Button
                android:id="@+id/sportident_card_accept_recovery"
                style="@style/dialog_action_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:enabled="false"
                android:text="@string/sportident_card_accept_recovery"
                android:textSize="17sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/sportident_card_write"
                style="@style/dialog_action_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:enabled="false"
                android:text="@string/sportident_card_write"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/sportident_card_guidance"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textSize="17sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
